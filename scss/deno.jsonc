{
  "imports": {
    "@std/fs": "jsr:@std/fs@1.0.24",
    "browserslist": "npm:browserslist@4.28.8",
    "lightningcss": "npm:lightningcss@1.33.0",
    "sass": "npm:sass@1.103.1"
  },
  "tasks": {
    "build": {
      "command": "deno run --allow-read --allow-write --allow-env --allow-ffi build.ts",
      "files": ["**/*.scss", "build.ts", "deno.jsonc", "deno.lock"],
      "output": ["dist/"]
    }
  }
}
